# Fail the install when the local Node or pnpm falls outside package.json
# `engines`. The build output in dist/ is committed and must be byte-identical
# between a developer machine and CI, so the toolchain is not advisory.
engine-strict=true

# New dependencies are pinned exactly, matching the convention in the other
# Zakhmban frontend repositories. Four applications consume this package's
# committed artifact; a floating range here is a range in all four.
save-exact=true
